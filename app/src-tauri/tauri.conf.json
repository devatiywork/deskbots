{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskBots",
  "version": "4.1.0",
  "identifier": "ru.devatiy.deskbots",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "cargo build --release -p deskbots-hook && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "devatiy",
    "shortDescription": "Пиксельный офис с ИИ-агентами на рабочем столе",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../target/release/deskbots-hook.exe": "deskbots-hook.exe" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Russian"], "displayLanguageSelector": false }
    }
  }
}
